<Page x:Class="ContractClaim.Pages.SubmitClaimPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Submit Claim" Background="#F4F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="White" CornerRadius="15" Padding="25" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Submit New Claim" FontSize="24" FontWeight="Bold" Foreground="#2c3e50"/>
                    <TextBlock Text="Complete the form below to submit your monthly contract claim" 
                               Foreground="#666" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Form -->
            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="30" Margin="0,0,0,20">
                <StackPanel x:Name="FormPanel" VerticalAlignment="Top">

                    <!-- Claim Month & Hours Worked -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Width="250" Margin="0,0,15,0">
                            <TextBlock Text="Claim Month" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker x:Name="DpClaimMonth"/>
                        </StackPanel>
                        <StackPanel Width="150">
                            <TextBlock Text="Hours Worked" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TbHoursWorked" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hourly Rate & Module -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Width="150" Margin="0,0,15,0">
                            <TextBlock Text="Hourly Rate (ZAR)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TbHourlyRate" Text="850" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Width="250">
                            <TextBlock Text="Module/Subject" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TbModule"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Estimated Total -->
                    <Border Background="#E8F5E8" BorderBrush="#27AE60" BorderThickness="2" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Estimated Total Amount" FontSize="12" Foreground="#666"/>
                            <TextBlock x:Name="TbEstimatedTotal" Text="R0.00" FontSize="20" FontWeight="Bold" Foreground="#27AE60"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Selection -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Claim Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbPending" Content="Pending Review" IsChecked="True" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbApproved" Content="Pre-Approved"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Supporting Documents -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Supporting Documents" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Button Content="Upload Files..." Click="BtnUpload_Click"/>
                        <TextBlock x:Name="TbFilesSelected" FontSize="12" Foreground="#666"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Additional Notes" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TbNotes" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Cancel" Width="150" Click="BtnCancel_Click" Margin="0,0,20,0"/>
                        <Button Content="Submit Claim" Width="150" Background="#667EEA" Foreground="White" Click="BtnSubmit_Click"/>
                    </StackPanel>

                    <!-- Success Message -->
                    <TextBlock x:Name="TbSuccessMessage" Text="Claim submitted successfully!" Foreground="Green" FontWeight="Bold" Visibility="Collapsed" 
                               Margin="0,20,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>


